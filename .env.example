# 複製成 .env 後填入你自己的值；.env 不會進 git。
# 申請網址與免費額度：見 docs/API_KEYS.md

# Alpha Vantage API Key（行情、基本面、技術指標；也用於 Alpha Vantage MCP Server）
ALPHAVANTAGE_API_KEY=

# Financial Modeling Prep API Key（財報、基本面；也用於 FMP MCP Server）
FMP_API_KEY=

# FinMind Token（選用；不填也能用，但每小時請求額度較低）
FINMIND_TOKEN=

# SEC EDGAR 規定必填的 User-Agent，格式：你的名字 your@email.com
# 值含空格，請用雙引號包起來，例如 SEC_USER_AGENT="Jane Doe jane@example.com"
# 只能用英文字元（名字請用英文或拼音，不能用中文）
SEC_USER_AGENT=

# Google Gemini API Key（AI 家教；選用，沒有時只提供規則式解說）
# 申請：https://aistudio.google.com/apikey　注意：免費方案送出的內容可能被 Google 用來改善產品，見 docs/AI.md
GEMINI_API_KEY=
# 選用：指定模型（預設 gemini-3.5-flash-lite）
GEMINI_MODEL=

# AI 家教密碼（必填才會開放 AI 家教；沒有設定時 AI 家教停用，其他功能照常）
# 值含空格或特殊符號時請用雙引號包起來
AI_TUTOR_PASSWORD=
